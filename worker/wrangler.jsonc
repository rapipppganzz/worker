{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rapip-watchparty",
  "main": "src/index.js",
  // Tanggal ini >= 2026-04-07, jadi runtime membalas frame Close otomatis (lihat dokumentasi WebSocket Durable Objects).
  "compatibility_date": "2026-04-07",

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "WatchRoom" },
      { "name": "LIMITER", "class_name": "RateLimiter" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },

  // Paket Free HANYA bisa memakai Durable Objects berbasis SQLite → wajib new_sqlite_classes (bukan new_classes).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WatchRoom", "RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],

  // Bukan rahasia (alamat ini juga ada di config.js frontend). Tidak ada secret yang wajib untuk mode verifikasi bawaan.
  "vars": {
    "AUTH_API": "https://website-gw-api.vercel.app",
    "AUTH_VERIFY_PATH": "/api/data",
    "ALLOWED_ORIGINS": "https://apk-rapipmovies.vercel.app",
    "MAX_PARTICIPANTS_CAP": "20",
    // ID akun (dipisah koma) yang room publiknya tampil paling atas sebagai "Server Resmi". Kosong = tidak ada.
    // Selama kosong, beranda menampilkan ID akun pemakai yang sedang login (salin ke sini).
    "OFFICIAL_HOST_IDS": "umvuq2n9z6911"
  },

  "observability": { "enabled": true }
}
